---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="th">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>สวัสดีครับ,</h1>
      <p style="text-align: center;">
        <picture>
          <source
            srcset="https://kpping.files.wordpress.com/2021/10/logo_v1_q85_r400x.jpg"
            media="(min-width: 400px)"
          />
          <source
            srcset="https://kpping.files.wordpress.com/2021/10/logo_v1_q85_r400x.jpg 2x, https://kpping.files.wordpress.com/2021/10/logo_v1_q85_r200x.jpg 1x"
            media="(min-width: 200px)"
          />
          <source
            srcset="https://kpping.files.wordpress.com/2021/10/logo_v1_q85_r200x.jpg 2x, https://kpping.files.wordpress.com/2021/10/logo_v1_q85_r100x.jpg 1x"
            media="(min-width: 100px)"
          />
          <img
            src="https://kpping.files.wordpress.com/2021/10/logo_v1_q85_r400x.jpg"
            alt="melon wish rain could stop soon"
            width="400"
            height="400"
            loading="lazy"
            decoding="async"
          />
          <!-- https://kpping.files.wordpress.com/2021/10/logo_v1.png -->
        </picture>
      </p>
      <p>
        &nbsp;&nbsp;&nbsp;&nbsp; ในยุคที่ Trend การบริโภค Content บน Internet
        เปลี่ยนไป หลาย ๆ คนเปลี่ยนไปดู Video มากกว่าอ่านบทความ
        เวลาอ่านก็ไม่ได้เข้า Website/RSS โดยตรงแล้ว แต่อ่านสรุปจาก AI หรือ Post
        ใน Social Network แทน
      </p>
      <p>
        ในช่วงที่ผ่านมา ผมรู้สึกว่าการเชื่อมต่อกันผ่าน Website ส่วนตัว
        เจือจางลงไปเยอะ เลยอยากเปลี่ยน Concept การเขียน Blog นี้
        ให้เน้นไปที่เหมือนการจดไดอารี่แทน ซึ่งน่าสนุกและท้ายทายมากกว่า
      </p>
      <p>
        Blog นี้เขียนแบบสบาย ๆ เน้นความเรียบง่าย ดูแลง่าย
        (แม้จะยกเครื่องใหม่หลายครั้ง) ผมเก็บ Contents ที่มีคนเข้าอ่านเยอะ ๆ ไว้
        แต่หลาย ๆ ครั้ง Tools ที่ใช้ Breaking Change เยอะ เลยขี้เกียจ Migrate
        ให้อ่านได้ต่อ (Content จะแหว่งบ้าง ขาดบ้าง ไม่เต็มอรรถรส
        เลยไม่เอาขึ้นดีกว่า) แต่หากคุณผู้อ่านอยากได้ข้อมูลไหนที่เคยลง
        เคยอ่านแต่หาไม่เจอแล้ว แจ้งได้นะครับ จะนำกลับมาลงให้ครับ
      </p>
      <p>❤️ Happy Reading & Writing 📝 ครับ</p>
    </main>
    <Footer />
  </body>
</html>
